],[136.0647,35.10508],[136.03324,35.11442],[136.02496,35.1359],[136.00798,35.1409],[136.00107,35.18618],[135.99585,35.19021],[135.97256,35.18098],[135.95931,35.14721]]]]}},{"id":"3389aff53c","name":"栗東市","page":"https://we-love-manho.com/siga/rittou/rittou.html","imgs":[{"url":"https://we-love-manho.com/siga/rittou/rittou2-2.jpg","kind":"design","desc":"淡海（おうみ）環境プラザ展示カラー蓋です。 インターチェンジを模った「町章」を外周に配置し、 その中に町のシンボルである「メジロ・キンセンカ・貝塚伊吹」を 配置しています。 これを通じて下水道に親しんでいただき、 また景観にマッチさせようと考えたものです。（淡海環境プラザの説明より)「りっとう」「おすい」の文字。 ※デザインは市制施行後の栗東市に引き継がれています。 汚水マンホールの蓋（写真はノンカラー版）"},{"url":"https://we-love-manho.com/siga/rittou/rittou5.jpg","kind":"emblem","desc":"規格蓋に市章（町章を継承）と「汚水」文字入り。受枠に楕円模様を2周。"},{"url":"https://we-love-manho.com/siga/rittou/rittou11.jpg","kind":"design","desc":"蜘蛛の巣模様の蓋にデザインされた「Ｇ」の文字と「ガス」の表示があり、 受枠は大中小３段の○の模様。 ガス"},{"url":"https://we-love-manho.com/siga/rittou/rittou8.jpg","kind":"design","desc":"蜘蛛の巣模様の蓋に、歯車状のマークと「ガス」の表示。 ガス"}],"point":[34.99725,136.0111],"bbox":[135.961,34.9438,136.0612,35.0507],"geom":{"type":"MultiPolygon","coordinates":[[[[136.04107,34.94527],[136.04883,34.95837],[136.06124,34.96417],[136.04262,34.98749],[136.03629,35.01194],[136.03889,35.02617],[136.01596,35.05067],[135.99492,35.03689],[135.96284,35.05069],[135.96101,35.03766],[135.97249,35.03137],[135.97047,35.01559],[135.99014,35.00798],[135.99919,34.99691],[135.98941,34.98],[136.01025,34.97554],[136.01011,34.95455],[136.01694,34.9438],[136.04107,34.94527]]]]}},{"id":"7b8d2dec05","name":"竜王町","page":"https://we-love-manho.com/siga/ryuuou/ryuuou.html","imgs":[{"url":"https://we-love-manho.com/siga/ryuuou/ryuuou.jpg","kind":"design","desc":"上記のノンカラー。 汚水管マンホールの蓋"},{"url":"https://we-love-manho.com/siga/ryuuou/ryuuou2.jpg","kind":"design","desc":"八角形と四角形の地模様の穴あき蓋に「農」と「竜王町」の表示と鍵穴あり。 農業用マンホールの蓋"}],"point":[35.05815,136.11835000000002],"bbox":[136.0732,35.0193,136.1635,35.097],"geom":{"type":"MultiPolygon","coordinates":[[[[136.07795,35.09202],[136.07863,35.06196],[136.07317,35.0523],[136.08663,35.0299