{
  "name": "geo-japan-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:stations": "tsx scripts/fetch/fetch-stations.ts && tsx scripts/build/build-stations.ts",
    "data:areacodes": "tsx scripts/fetch/fetch-area-codes.ts && tsx scripts/fetch/fetch-muni-geo.ts && tsx scripts/fetch/fetch-legacy-geo.ts && tsx scripts/fetch/fetch-chocho-geo.ts && tsx scripts/build/build-areacodes.ts",
    "data:legacy": "tsx scripts/fetch/fetch-legacy-geo.ts && tsx scripts/build/build-legacy.ts",
    "data:outline": "tsx scripts/fetch/fetch-muni-geo.ts && tsx scripts/build/build-pref-outline.ts && tsx scripts/build/build-muni-outline.ts",
    "data:manholes": "tsx scripts/fetch/fetch-manholes.ts && tsx scripts/build/build-manholes.ts"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@types/geojson": "^7946.0.16",
    "leaflet": "^1.9.4",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "pdfjs-dist": "^3.11.174",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
