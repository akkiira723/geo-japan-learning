{
  "permissions": {
    "deny": [
      "Edit(public/data/**)",
      "Write(public/data/**)",
      "Edit(dist/**)",
      "Write(dist/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ]
  }
}
